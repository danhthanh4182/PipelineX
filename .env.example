# AIHOT Configuration. Copy to .env and edit (or run `node scripts/init-env.ts`, which generates .env with random secrets).
# Frontend only receives the site URL; all secret keys stay on the backend. Never commit .env to Git.

# ===== Required =====

# Public URL of the site: used for generated links, RSS, share images, MCP. For local testing use the value below:
SITE_URL=http://localhost:3000

# Administrator password (at least 12 characters), used to log into /admin.
ADMIN_PASSWORD=

# Session signing secret and image proxy signing secret, fill each with a random string (e.g. generate via `openssl rand -hex 32`).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Database password when using Docker (database ports are not exposed publicly, please use random characters).
POSTGRES_PASSWORD=

# Model: Any OpenAI-compatible API is supported and used by default across all pipeline steps. Example below is for DeepSeek:
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Provider-specific request parameters (JSON), e.g. disabling thinking mode:
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# Examples for other providers:
#   Qwen      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   GLM       LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash  LLM_EXTRA_JSON={"thinking":{"type":"enabled"},"reasoning_effort":"low"}
# Enable vision if model supports images (featured story title/summary will reference first image):
# LLM_VISION=true
# Disable if provider does not support JSON mode (response_format):
# LLM_JSON_MODE=false
# Additional output quota reserved for reasoning in reasoning models (thinking tokens share total output budget). Added to each step's budget; defaults to 0.
# Set this if API returns "output token limit reached (finish_reason=length)", e.g.:
# LLM_REASONING_TOKENS=4000

# ===== Optional: More accurate event clustering =====

# Vector embeddings: Any OpenAI-compatible /embeddings API. Works without this: clustering falls back to lexical overlap for candidate retrieval,
# but discussion posts that only act as heat evidence (hot_signal sources) rarely attach to events, resulting in lower heat scores.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# Or fill only DashScope API key to use text-embedding-v4:
# DASHSCOPE_API_KEY=
# Embedding dimensions (when using EMBEDDING_*, defaults to provider return value; DashScope defaults to 1024). When changed, old embeddings are recomputed:
# EMBEDDING_DIMS=

# ===== Optional: Override models per pipeline step =====
# Defaults to using LLM_* above for all steps. To override a step with a different provider, set a preset name (requires corresponding key):
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  WORDING_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# Preset names and required keys:
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# Note: If DASHSCOPE_API_KEY is set and EMBEDDING_API_KEY is unset, clustering automatically uses DashScope embeddings (text-embedding-v4), billed separately by DashScope.

# ===== Optional: Paid scraping services (billed per request, with budget circuit breakers, configured in admin Settings) =====
# X (Twitter) accounts: SocialData
# SOCIALDATA_API_KEY=
# WeChat Official Accounts: Dajiala
# DAJIALA_KEY=
# Browser rendering fallback when full text extraction fails: Jina Reader
# JINA_API_KEY=

# ===== Optional: Feishu / Lark =====
# Push featured stories to Feishu group (only pushes T1 and T1_5 sources): Enable under Admin "Settings -> Notification Destinations", fill webhook URL here.
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# Forward alerts and feedback to internal Feishu group (feedback requires a custom Feishu app):
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# Alerts can also be sent in plain text to a custom group bot: setting this uses webhook instead of app/chat IDs (does not consume app API quotas).
# FEISHU_ALERT_WEBHOOK_URL=
# Forward alerts to your own automated handling service (e.g. Webhook hub that wakes an AI agent). Used only when both are set and FEISHU_INTERNAL_ENABLED=true:
# Alerts to handle are POSTed to this URL (Authorization: Bearer <KEY>, JSON fields id, type, subject, summary, detail, link); HTTP 200 counts as received, same id may be resent.
# Personal alerts, recoveries, and daily digest are first POSTed to /tell on same host (JSON fields key, text); if not accepted, falls back to Feishu above. See docs/deploy.md "Updates".
# WEBHOOK_HUB_URL=
# WEBHOOK_HUB_KEY=

# ===== Optional: DingTalk =====
# Push featured stories to DingTalk group (shares the same pipeline as Feishu content push, also only pushes T1 and T1_5 sources):
# Enable "DingTalk Content Group" under Admin "Settings -> Notification Destinations", fill webhook URL here.
# DINGTALK_CONTENT_PUSH_ENABLED=true
# DingTalk custom bot Webhook URL (including access_token):
# DINGTALK_PUSH_WEBHOOK_URL=
# Fill secret (starts with SEC) only if bot security settings use "HMAC signature"; leave blank for "Custom Keywords" or "IP Whitelist":
# DINGTALK_PUSH_SECRET=

# ===== Optional: Miscellaneous =====
# Provide GitHub Token for JSON feeds calling GitHub API (api.github.com) for higher rate limits. Free to generate on GitHub, requires read-only permissions only:
# GITHUB_TOKEN=
# Bearer token for external scripts pushing content (POST /api/ingest/items), at least 16 characters; unset to disable this endpoint.
# INGEST_TOKEN=
# Push rate limit per client per minute (docker compose default 10); set to 0 if reverse proxy already handles rate limiting:
# INGEST_RATE_LIMIT=10
# Egress proxy for scraping external sources (e.g. if server is located behind firewalls):
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# DoH upstreams for resolving domains through proxy, tried in order, comma-separated (defaults to the two below).
# In proxy environments where cloudflare-dns.com is unreachable (TLS handshake reset), the second serves as fallback:
# EGRESS_DNS_UPSTREAMS=https://cloudflare-dns.com/dns-query, https://dns.google/resolve
# By default, domain names are resolved and validated as public IP addresses before proxy connects (preventing DNS rebinding).
# If proxy does not support IP tunneling (connection reset), set to false: validates once, but proxy resolves again internally;
# only set to false if proxy itself cannot reach internal network:
# EGRESS_PIN_DNS=false
# Comma-separated exact hostnames of internal feeds (e.g. RSSHub running in the same Docker network). Case-insensitive, no wildcards.
# Whitelists direct connections for feed URLs only, bypassing proxy; redirect targets, article bodies, and images still cannot access internal networks:
# PRIVATE_FEED_HOSTS=rsshub
# Bandwidth budget for image proxy fetching images from origin sites (MB/min, GB/day); uncached images return 503 when exceeded. Unset to use site/site.ts DEPLOYMENT.imageUpstreamBudget (defaults to unlimited):
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# Set to true when running behind a reverse proxy (Caddy, Nginx) so client IP is read from X-Forwarded-For;
# Keep false if site is exposed directly, preventing spoofed headers from bypassing rate limits.
TRUST_PROXY=false
# MCP server only accepts requests targeting SITE_URL hostname (and localhost); comma-separated additional domains can be listed here:
# MCP_ALLOWED_HOSTS=
# Quiet threshold in minutes before alerting that no new content has been indexed; unset to use site/site.ts ALERTS.quietMinutes (default 360):
# ALERT_QUIET_MINUTES=360
# Submit new pages daily to IndexNow (Bing, etc.); key is a 32-hex character string:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# Push newly indexed pages hourly to Baidu; verify site in Baidu Search Resource Platform first, token is the tail of push URL in "Regular Ingestion · API Submit":
BAIDU_PUSH_ENABLED=false
# BAIDU_PUSH_TOKEN=
# Database daily backup to S3-compatible object storage (Tencent COS, AWS S3, Aliyun OSS, etc.).
# When DB_BACKUP_STORE_DOMAIN is unset, builds Tencent COS URL (<bucket>.cos.<region>.myqcloud.com);
# For other providers, provide endpoint including bucket, e.g. for AWS S3: my-bucket.s3.us-east-1.amazonaws.com:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# Logging level (default info) and database pool maximum connections (default 10):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# Release version: shown in admin "Operations" page and /api/health to confirm updated process after deploy:
# AIHOT_RELEASE=
# Environment name, defaults to NODE_ENV (production or development); included in alerts if non-production; dev passwordless login only allowed in non-production:
# AIHOT_ENVIRONMENT=
# Directory holding credential files by group (models.env, collectors.env, integrations.env, auth.env) instead of specifying here; values here take priority:
# AIHOT_CREDENTIALS_DIR=

# ===== Safety Valves =====
# Set to true to enable feed collection (including daily icon fetch) and model calls; remove or set false to pause all (useful for UI debugging).
# All *_ENABLED flags only recognize true; 1, yes, or TRUE are treated as false.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Only required when running natively on local host without Docker =====
# DATABASE_URL=postgres://username@127.0.0.1:5432/myhot
# API_BASE_URL=http://127.0.0.1:3001
# Storage directory for uploaded files, image cache, and local backups (defaults to .data in repo):
# AIHOT_DATA_DIR=/var/lib/myhot
# Passwordless admin login during development (startup rejected in production), display name in admin UI:
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# Allow fetching private network IP addresses during local debugging (forbidden by default, rejected in production):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== When using docker compose --profile https =====
# SITE_DOMAIN=example.com
# Local port bound by website (used by docker compose, default 3000, bound on all interfaces); when HTTPS enabled, only used by local Caddy:
# PORT=127.0.0.1:3000
# Also set TRUST_PROXY=true above.

# ===== PipelineX: video module =====
# Minimum independent sources required for an event to qualify as video candidate (default 3).
# VIDEO_MIN_SOURCES=3
# Translate article full text to Chinese (enabled by default). For English site: set false.
# TRANSLATE_ENABLED=false
